# Qloo Taste AI
# https://docs.qloo.com
QLOO_API_KEY=

# TypeSafe Jev: card identification (server-only)
# https://docs.typesafe.ai
TYPESAFE_API_KEY=

# Free OpenAI-compatible LLM tiers for the website chat (any subset; see docs/spec.md §5.9)
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Model provider used for entity extraction and ranking explanations
FOCAL_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# MCP server
FOCAL_API_KEY=
FOCAL_MCP_TRANSPORT=stdio
FOCAL_MCP_PORT=8787

# Qloo API base URL (hackathon keys only work against this host)
QLOO_API_BASE=https://hackathon.api.qloo.com

# Set to 1 for local mock data; NEVER enabled in production deployments
QLOO_MOCK=

# Dev only (ignored when NODE_ENV=production): any bearer token on /api/page/* maps to a demo user + profile until accounts land.
FOCAL_DEV_SESSION=

# Postgres for packages/db (local: docker run -p 5432:5432 -e POSTGRES_USER=focal -e POSTGRES_PASSWORD=focal -e POSTGRES_DB=focal postgres:17-alpine)
DATABASE_URL=
# Direct (non-pooler) URL for migrations; `neon env pull` writes both
DATABASE_URL_UNPOOLED=

# Sign-in (WorkOS AuthKit). Auth routes 404 until all three are set.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Hosted MCP (/mcp): AuthKit domain from WorkOS → Connect → Configuration, e.g. your-app.authkit.app.
WORKOS_AUTHKIT_DOMAIN=
# Public origin used in OAuth metadata; defaults to the request's host.
FOCAL_PUBLIC_URL=
# Extension id allowed to receive the session token on /connect
NEXT_PUBLIC_FOCAL_EXTENSION_ID=
