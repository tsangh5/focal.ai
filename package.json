{
  "name": "focal-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @focal-ai/web dev",
    "dev:all": "pnpm --parallel --filter @focal-ai/web --filter @focal-ai/mcp dev",
    "build": "pnpm --filter @focal-ai/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check": "pnpm -r typecheck && pnpm -r test",
    "probe": "tsx scripts/probe-qloo.ts",
    "probe:unknowns": "tsx scripts/probe-unknowns.ts",
    "smoke": "tsx scripts/smoke-prod.ts",
    "e2e": "pnpm --filter @focal-ai/e2e e2e"
  },
  "devDependencies": {
    "@neon/config": "1.9.2",
    "@neon/env": "1.6.3",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
